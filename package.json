{
  "name": "fix-lang",
  "version": "0.36.0",
  "description": "Local macOS menu-bar app: AI text correction and writing tools via OpenAI, OpenRouter, Anthropic, AWS Bedrock, Ollama, or LM Studio",
  "author": {
    "name": "Anhdd Kuro",
    "email": "anhdd.kuro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anhdd-kuro/fix-lang.git"
  },
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "start": "electron-vite preview",
    "predev": "bun run build",
    "dev": "electron-vite dev",
    "dev:promptgen": "FIXLANG_FEATURES=promptgen bun run dev",
    "pack": "rm -rf release && electron-vite build && bun run check:bundle && electron-builder --mac",
    "pack:mac": "rm -rf release && electron-vite build && bun run check:bundle && electron-builder --mac dir -c.appId=com.fixlang.app.dev -c.productName='FixLang Dev'",
    "pack:mac:prod": "rm -rf release && electron-vite build && bun run check:bundle && electron-builder --mac dir",
    "pack:mac:promptgen": "FIXLANG_FEATURES=promptgen bun run pack:mac",
    "release:mac": "electron-vite build && bun run check:bundle && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "install:applications": "if [ -d \"release/mac-arm64/FixLang.app\" ]; then rm -rf \"/Applications/FixLang.app\" && cp -R \"release/mac-arm64/FixLang.app\" \"/Applications/FixLang.app\"; elif [ -d \"release/mac/FixLang.app\" ]; then rm -rf \"/Applications/FixLang.app\" && cp -R \"release/mac/FixLang.app\" \"/Applications/FixLang.app\"; else echo \"Build output not found. Run bun run pack:mac:prod first.\" && exit 1; fi",
    "pack:install": "bun run pack:mac:prod && bun run install:applications",
    "prebuild": "bun run themes:generate",
    "build": "electron-vite build",
    "build:promptgen": "FIXLANG_FEATURES=promptgen bun run build",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error && oxfmt --check",
    "lint:fix": "oxlint --type-aware --fix && oxfmt --write",
    "format": "oxfmt --write",
    "test:rules": "node --test 'tools/oxlint/**/*.test.ts'",
    "typecheck": "node node_modules/@typescript/seven/bin/tsc --noEmit",
    "typecheck:ts6": "node node_modules/typescript/bin/tsc --noEmit",
    "i18n:check": "bun run scripts/i18n-check.ts",
    "check:bundle": "bun run scripts/check-bundle-externals.ts",
    "vitest": "vitest",
    "test": "vitest --watch=false",
    "test:coverage": "vitest --watch=false --coverage.enabled",
    "test:w": "vitest",
    "themes:download": "bun run themes:download:tm && bun run themes:download:terminal",
    "themes:generate": "bun run scripts/generate-theme-css.ts",
    "themes:sync": "bun run themes:download && bun run themes:generate",
    "themes:download:terminal": "bun run scripts/download-terminalcolors.ts",
    "themes:download:tm": "bun run scripts/download-themes.ts"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/seven": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.156",
    "autoprefixer": "10.6.2",
    "colord": "2.10.0",
    "electron": "43.8.4",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tailwindcss": "1.17.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-select": "5.10.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-commonjs": "0.10.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.127",
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/provider-utils": "5.0.70",
    "@aws-sdk/client-bedrock": "3.1159.0",
    "@tanstack/react-virtual": "3.14.23",
    "chart.js": "4.6.1",
    "date-fns": "4.4.0",
    "electron-store": "12.0.0",
    "fuse.js": "7.5.0",
    "ollama": "0.6.4",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "undici": "8.12.3",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.fixlang.app",
    "productName": "FixLang",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "electronLanguages": [
        "en",
        "ja"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false,
      "format": "ULFO",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "unrs-resolver"
  ]
}
